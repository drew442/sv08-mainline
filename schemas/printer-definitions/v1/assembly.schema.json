{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sv08:printer-definitions:0.1:assembly",
  "type": "object",
  "required": [
    "format_version",
    "id",
    "version",
    "kind",
    "name",
    "category",
    "hardware",
    "compatibility",
    "sources",
    "license"
  ],
  "properties": {
    "format_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "kind": {
      "const": "assembly"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 32
    },
    "category": {
      "type": "string"
    },
    "hardware": {
      "type": "object"
    },
    "compatibility": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "id",
          "locator"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "license": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    },
    "dependencies": {
      "type": "array"
    },
    "conflicts": {
      "type": "array"
    },
    "inputs": {
      "type": "object"
    },
    "calibration": {
      "type": "array"
    },
    "unresolved": {},
    "components": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "board",
          "settings",
          "endpoints"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "sensor",
              "input",
              "probe",
              "fan",
              "bed",
              "motor",
              "extruder",
              "chamber"
            ]
          },
          "board": {
            "enum": [
              "main",
              "tool",
              "chamber"
            ]
          },
          "settings": {
            "type": "object"
          },
          "endpoints": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "endpoint",
          "board",
          "connector",
          "capability",
          "board_ids"
        ],
        "properties": {
          "endpoint": {
            "type": "string"
          },
          "board": {
            "enum": [
              "main",
              "tool",
              "chamber"
            ]
          },
          "connector": {
            "type": "string"
          },
          "capability": {
            "enum": [
              "adc",
              "heater",
              "fan",
              "probe",
              "input",
              "motor"
            ]
          },
          "board_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "contact": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "behaviours": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
