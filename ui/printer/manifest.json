{
  "version": 1,
  "tools": {
    "index": {
      "label": "Printer hardware",
      "path": "index.html",
      "order": 20
    }
  },
  "content-security-policy": "default-src 'self'; connect-src 'self' ws: wss:; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'",
  "bridges": [
    {
      "privileged": true,
      "environ": [
        "SUDO_ASKPASS=${libexecdir}/cockpit-askpass"
      ],
      "spawn": [
        "sudo",
        "-k",
        "-A",
        "cockpit-bridge",
        "--privileged"
      ]
    }
  ]
}
