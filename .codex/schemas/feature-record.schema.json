{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "kind": {
      "enum": [
        "feature",
        "improvement",
        "fix"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "created": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "proposal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "owner_decision_required": {
      "type": "boolean"
    },
    "decision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "enum": [
                "approved",
                "approved-with-constraints",
                "rejected",
                "needs-research",
                "deferred"
              ]
            },
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "session": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "authority": {
              "enum": [
                "delegated",
                "owner-existing"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "proposal_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "requirements_sha256": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1000,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                    },
                    "minItems": 1,
                    "maxItems": 1000
                  }
                },
                "required": [
                  "text",
                  "checks"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 1000
            },
            "scope_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "outcome",
            "reviewer",
            "session",
            "authority",
            "rationale",
            "proposal_sha256",
            "requirements_sha256",
            "constraints",
            "scope_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "environment": {
            "enum": [
              "offline",
              "hardware",
              "human"
            ]
          }
        },
        "required": [
          "id",
          "description",
          "environment"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "review",
              "blocked",
              "done"
            ]
          },
          "environment": {
            "enum": [
              "offline",
              "hardware",
              "human"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "human_task": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              {
                "type": "null"
              }
            ]
          },
          "blocker": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              {
                "type": "null"
              }
            ]
          },
          "implementation": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "actor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "session": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "run": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  }
                },
                "required": [
                  "actor",
                  "session",
                  "run"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "check": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                },
                "environment": {
                  "enum": [
                    "offline",
                    "hardware",
                    "human"
                  ]
                },
                "document": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "document_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_sha256": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1000,
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "source_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "limitations": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "profile": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "board_revision": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "check",
                "environment",
                "document",
                "document_sha256",
                "source_sha256",
                "source_commit",
                "method",
                "limitations",
                "profile",
                "board_revision"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "verification": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "enum": [
                      "passed",
                      "failed"
                    ]
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "session": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000
                  },
                  "evidence_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "decision_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "outcome",
                  "reviewer",
                  "session",
                  "rationale",
                  "evidence_sha256",
                  "decision_sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "repeats": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "resumption": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "environment",
          "depends_on",
          "checks",
          "human_task",
          "blocker",
          "implementation",
          "evidence",
          "verification",
          "repeats",
          "resumption"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "required": [
    "format_version",
    "id",
    "kind",
    "title",
    "author",
    "created",
    "priority",
    "proposal",
    "requirements",
    "owner_decision_required",
    "decision",
    "checks",
    "tasks"
  ],
  "additionalProperties": false
}
