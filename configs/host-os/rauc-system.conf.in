[system]
compatible=@COMPATIBLE@
bootloader=custom
bundle-formats=verity
activate-installed=false
data-directory=/var/lib/rauc
perform-pre-check=true

[handlers]
bootloader-custom-backend=/usr/lib/sv08/sv08_rauc_bootloader.py

[keyring]
path=/etc/rauc/release-keyring.pem

[slot.rootfs.0]
device=@ROOT_A@
type=ext4
bootname=A

[slot.boot.0]
device=@BOOT_A@
type=vfat
parent=rootfs.0

[slot.rootfs.1]
device=@ROOT_B@
type=ext4
bootname=B

[slot.boot.1]
device=@BOOT_B@
type=vfat
parent=rootfs.1
