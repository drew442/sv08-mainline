[system]
compatible=@COMPATIBLE@
bootloader=uboot
bundle-formats=verity
activate-installed=false
boot-attempts=3
boot-attempts-primary=3
data-directory=/var/lib/rauc
perform-pre-check=true

[keyring]
path=/etc/rauc/release-keyring.pem

[slot.rootfs.0]
device=@ROOT_A@
type=ext4
bootname=A

[slot.boot.0]
device=@BOOT_A@
type=vfat
parent=rootfs.0

[slot.rootfs.1]
device=@ROOT_B@
type=ext4
bootname=B

[slot.boot.1]
device=@BOOT_B@
type=vfat
parent=rootfs.1
