[Unit]
Description=Queue an already commissioned SV08 Klipper start
Requires=sv08-prepare.service sv08-boot-health.service
After=sv08-prepare.service sv08-boot-health.service

[Service]
Type=oneshot
User=root
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=20
ExecStart=/usr/bin/python3 /usr/lib/sv08/sv08_commissioning.py boot-activate
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
