[Unit]
Description=Provision and validate private SV08 web authentication
Requires=sv08-printer-api.service
After=sv08-printer-api.service
Before=sv08-mainsail.service

[Service]
Type=oneshot
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/python3 /usr/lib/sv08/sv08_restart.py check-start
ExecStart=/usr/bin/python3 /usr/lib/sv08/sv08_web.py auth
RemainAfterExit=yes
TimeoutStartSec=120
