[Unit]
Description=SV08 loopback printer API
Requires=sv08-web-prepare.service
After=sv08-web-prepare.service network.target

[Service]
Type=simple
User=sv08
Group=sv08
PrivateDevices=yes
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=+/usr/bin/python3 /usr/lib/sv08/sv08_restart.py check-start
ExecStart=/opt/sv08-mainline/venvs/moonraker-985c1d0/bin/python /opt/sv08-mainline/moonraker/moonraker/moonraker.py -d /run/sv08/printer_data -l /var/log/printer/moonraker.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
