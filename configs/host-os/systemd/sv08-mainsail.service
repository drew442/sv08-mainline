[Unit]
Description=Authenticated SV08 Mainsail HTTPS gateway
Requires=sv08-web-auth.service sv08-identity.service
After=sv08-web-auth.service sv08-identity.service

[Service]
Type=simple
User=sv08
Group=sv08
PrivateDevices=yes
RuntimeDirectory=sv08-mainsail
RuntimeDirectoryMode=0700
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=+/usr/bin/flock --nonblock /run/sv08/admission.lock /usr/bin/true
ExecStartPre=/usr/sbin/nginx -t -c /etc/sv08/nginx-mainsail-service.conf
ExecStart=/usr/sbin/nginx -c /etc/sv08/nginx-mainsail-service.conf -g 'daemon off;'
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
