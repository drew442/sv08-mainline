# Deliberately independent of the installed A/B eMMC environment.
CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h616-sovol-sv08-sd-network"
CONFIG_OF_LIST="allwinner/sun50i-h616-sovol-sv08-sd-network"
CONFIG_DRAM_CLK=720
CONFIG_AXP_DCDC2_VOLT=1000
CONFIG_AXP_DCDC3_VOLT=1500
# CONFIG_BOOTSTD is not set
# CONFIG_BOOTMETH_RAUC is not set
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_REDUNDANT is not set
# CONFIG_CMD_SAVEENV is not set
# CONFIG_CMD_PART is not set
# CONFIG_CMD_EXT4 is not set
# CONFIG_CMD_BOOTFLOW is not set
# CONFIG_CMD_BOOTMETH is not set
# CONFIG_CMD_FAT_WRITE is not set
CONFIG_CMD_MMC=y
CONFIG_MMC_SUNXI_SLOT_EXTRA=-1
CONFIG_CMD_FAT=y
CONFIG_CMD_HASH=y
CONFIG_HASH_VERIFY=y
CONFIG_SHA256=y
CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="sv08-sd-network.env"
