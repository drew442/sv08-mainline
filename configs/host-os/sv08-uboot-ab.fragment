# Apply to pinned patched bigtreetech_cb1_defconfig, then olddefconfig.
# New DT source should be installed at dts/upstream/src/arm64/allwinner/
# sun50i-h616-sovol-sv08-diagnostic.dts and explicitly built/verified.
CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h616-sovol-sv08-diagnostic"
CONFIG_OF_LIST="allwinner/sun50i-h616-sovol-sv08-diagnostic"
CONFIG_DRAM_CLK=720
CONFIG_AXP_DCDC2_VOLT=1000
CONFIG_AXP_DCDC3_VOLT=1500
CONFIG_BOOTDELAY=3
CONFIG_BOOTSTD=y
CONFIG_BOOTSTD_FULL=y
CONFIG_BOOTMETH_RAUC=y
CONFIG_BOOTMETH_RAUC_PARTITIONS="1,2 3,4"
CONFIG_BOOTMETH_RAUC_BOOT_ORDER="A B"
CONFIG_BOOTMETH_RAUC_DEFAULT_TRIES=3
# CONFIG_BOOTMETH_RAUC_RESET_ALL_ZERO_TRIES is not set
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_REDUNDANT=y
# CONFIG_ENV_REDUNDANT_UPGRADE is not set
CONFIG_ENV_MMC_DEVICE_INDEX=1
CONFIG_ENV_MMC_EMMC_HW_PARTITION=0
CONFIG_ENV_OFFSET=0x400000
CONFIG_ENV_OFFSET_REDUND=0x800000
CONFIG_ENV_SIZE=0x10000
CONFIG_CMD_MMC=y
CONFIG_CMD_PART=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FAT=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_BOOTFLOW=y
CONFIG_CMD_BOOTMETH=y
CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
# Replace with exact generated plaintext environment path in the build tree.
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="sv08-default.env"
