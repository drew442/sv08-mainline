+    const video = { srcObject: null } as unknown as HTMLVideoElement
+    const status = vi.fn(),
+        player = new JanusStream(video, status, sdk)
+    const handle = { send: vi.fn(), createAnswer: vi.fn(), detach: vi.fn() }
+    const connect = () => {
+        inits.at(-1).callback()
+        sessions.at(-1).options.success()
+        plugins.at(-1).success(handle)
+    }
+    return { sdk, video, status, player, handle, inits, sessions, plugins, connect }
+}
