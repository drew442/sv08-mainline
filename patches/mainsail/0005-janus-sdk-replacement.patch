+// SPDX-License-Identifier: AGPL-3.0-or-later
+import adapter from 'webrtc-adapter'
+import Janus, { type Plugin, type Session, type Sdk, type StreamConfig } from '../vendor/janus'
+
+type Run = {
+    active: boolean
+    session?: Session
+    handle?: Plugin
+    media: MediaStream
+    connected: boolean
+    pending: boolean
+    finish?: () => void
+}
+
+// Own one viewing session. Invalidating a run precedes all cleanup, so callbacks
+// from initialization, negotiation or a previous camera cannot mutate its successor.
+export class JanusStream {
+    private run?: Run
+    private teardown?: Promise<void>
+
+    constructor(
+        private readonly video: HTMLVideoElement,
+        private readonly status: (value: string) => void,
+        private readonly sdk: Sdk = Janus
+    ) {}
+
+    stop(): Promise<void> {
+        const run = this.run
+        this.run = undefined
+        if (!run) return this.teardown ?? Promise.resolve()
+        run.active = false
+        this.clear(run)
+        if (!run.connected && !run.pending) return this.teardown ?? Promise.resolve()
+        const teardown = new Promise<void>((resolve) => {
+            run.finish = resolve
+        })
+        this.teardown = teardown
+        void teardown.then(() => {
+            if (this.teardown === teardown) this.teardown = undefined
+        })
+        // A still-creating session is destroyed when its success callback arrives.
+        if (run.connected) this.destroy(run)
+        return teardown
+    }
+
+    private destroy(run: Run) {
+        const finish = () => {
+            run.finish?.()
+            run.finish = undefined
+        }
+        try {
+            run.session?.destroy({ success: finish, error: finish })
+        } catch {
+            finish()
+        }
+    }
+
+    private clear(run: Run) {
+        for (const track of run.media.getTracks()) {
+            run.media.removeTrack(track)
+            track.stop()
+        }
+        if (this.video.srcObject === run.media) this.video.srcObject = null
+    }
+
+    start(config: StreamConfig, id: number) {
+        this.stop()
+        const run: Run = { active: true, media: new MediaStream(), connected: false, pending: false }
+        this.run = run
+        this.status('connecting')
+        const current = () => run.active && this.run === run
+        const fail = (error: unknown) => {
+            if (!current()) return
+            this.status(`errored: ${JSON.stringify(error)}`)
+            this.stop()
+        }
+        const begin = () => {
+            if (!current()) return
+            try {
+                this.sdk.init({
+                    debug: false,
+                    dependencies: this.sdk.useDefaultDependencies({ adapter }),
+                    callback: () => {
+                        if (!current()) return
+                        try {
+                            run.pending = true
+                            run.session = new this.sdk({
+                                ...config,
+                                success: () => {
+                                    // SDK success is asynchronous, after construction assigns session.
+                                    run.pending = false
+                                    run.connected = true
+                                    if (!current()) {
+                                        this.destroy(run)
+                                        return
+                                    }
+                                    try {
+                                        run.session!.attach({
+                                            plugin: 'janus.plugin.streaming',
+                                            success: (handle) => {
+                                                if (!current()) {
+                                                    handle.detach({})
+                                                    return
+                                                }
+                                                run.handle = handle
+                                                try {
+                                                    this.sdk.attachMediaStream(this.video, run.media)
+                                                    handle.send({ message: { request: 'watch', id }, error: fail })
+                                                } catch (error) {
+                                                    fail(error)
+                                                }
+                                            },
+                                            error: fail,
+                                            onmessage: (message, jsep) => {
+                                                if (!current()) return
+                                                if (message.error) {
+                                                    fail(message.error)
+                                                    return
+                                                }
+                                                if (message.result?.status) this.status(message.result.status)
+                                                if (jsep && run.handle) {
+                                                    try {
+                                                        // Preserve the original createAnswer({jsep}) defaults:
+                                                        // receive offered media, no added capture/media options.
+                                                        run.handle.createAnswer({
+                                                            jsep,
+                                                            error: fail,
+                                                            success: (answer) => {
+                                                                if (!current()) return
+                                                                try {
+                                                                    run.handle?.send({
+                                                                        message: { request: 'start' },
+                                                                        jsep: answer,
+                                                                        error: fail,
+                                                                    })
+                                                                } catch (error) {
+                                                                    fail(error)
+                                                                }
+                                                            },
+                                                        })
+                                                    } catch (error) {
+                                                        fail(error)
+                                                    }
+                                                }
+                                            },
+                                            onremotetrack: (track, _mid, on) => {
+                                                if (!current()) return
+                                                if (on) {
+                                                    if (!run.media.getTracks().includes(track))
+                                                        run.media.addTrack(track)
+                                                } else run.media.removeTrack(track)
+                                            },
+                                            iceState: (state) => {
+                                                if (!current()) return
+                                                console.log(`ICE state changed to ${state}`)
+                                                if (state === 'failed') fail('ICE failed')
+                                            },
+                                            oncleanup: () => {
+                                                if (current()) this.clear(run)
+                                            },
+                                        })
+                                    } catch (error) {
+                                        fail(error)
+                                    }
+                                },
+                                error: (error) => {
+                                    run.pending = false
+                                    run.finish?.()
+                                    fail(error)
+                                },
+                                destroyed: () => {
+                                    run.finish?.()
+                                    if (current()) fail('Session destroyed')
+                                },
+                            })
+                        } catch (error) {
+                            run.pending = false
+                            run.finish?.()
+                            fail(error)
+                        }
+                    },
+                })
+            } catch (error) {
+                fail(error)
+            }
+        }
+        // Wait for the SDK's destruction completion, including pending creation.
+        // Rapid starts replace the waiting run; only the latest can initialize.
+        if (this.teardown) void this.teardown.then(begin)
+        else begin()
+    }
+}
