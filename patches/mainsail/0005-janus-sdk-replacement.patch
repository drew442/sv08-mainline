+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Narrow declarations authored for Mainsail's streaming consumer.
+export interface Jsep {
+    type: RTCSdpType
+    sdp: string
+}
+export interface Plugin {
+    send(options: { message: { request: string; id?: number }; jsep?: Jsep; error: (error: unknown) => void }): void
+    createAnswer(options: { jsep: Jsep; success: (answer: Jsep) => void; error: (error: unknown) => void }): void
+    detach(options: { success?: () => void; error?: (error: unknown) => void }): void
+}
+export interface Session {
+    attach(options: {
+        plugin: string
+        success: (handle: Plugin) => void
+        error: (error: unknown) => void
+        onmessage: (message: { result?: { status?: string }; error?: unknown }, jsep?: Jsep) => void
+        onremotetrack: (track: MediaStreamTrack, mid: string, on: boolean) => void
+        iceState: (state: string) => void
+        oncleanup: () => void
+    }): void
+    destroy(options: { success?: () => void; error?: (error: unknown) => void }): void
+}
+export interface StreamConfig {
+    server: string
+    iceServers?: RTCIceServer[]
+}
+export interface Sdk {
+    new (
+        options: StreamConfig & { success: () => void; error: (error: unknown) => void; destroyed: () => void }
+    ): Session
+    init(options: { debug: false; dependencies: unknown; callback: () => void }): void
+    useDefaultDependencies(options: { adapter: unknown }): unknown
+    attachMediaStream(element: HTMLMediaElement, stream: MediaStream): void
+}
+declare const Janus: Sdk
+export default Janus
