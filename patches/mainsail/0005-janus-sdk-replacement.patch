+
+class Media {
+    tracks: MediaStreamTrack[] = []
+    getTracks() {
+        return [...this.tracks]
+    }
+    addTrack(track: MediaStreamTrack) {
+        this.tracks.push(track)
+    }
+    removeTrack(track: MediaStreamTrack) {
+        this.tracks = this.tracks.filter((t) => t !== track)
+    }
+}
+function fixture() {
