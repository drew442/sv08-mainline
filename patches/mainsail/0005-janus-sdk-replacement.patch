+        sessions: any[] = [],
+        plugins: any[] = []
+    const sdk = Object.assign(
+        function (this: any, options: any) {
+            this.options = options
+            this.destroy = vi.fn((callbacks) => callbacks.success?.())
+            this.attach = vi.fn((callbacks) => plugins.push(callbacks))
+            sessions.push(this)
+        },
+        {
+            init: vi.fn((options) => inits.push(options)),
+            useDefaultDependencies: vi.fn((options) => options),
+            attachMediaStream: vi.fn((video, media) => {
+                video.srcObject = media
+            }),
