diff --git a/dts/upstream/src/arm64/allwinner/sun50i-h616-sovol-sv08-diagnostic.dts b/dts/upstream/src/arm64/allwinner/sun50i-h616-sovol-sv08-diagnostic.dts
new file mode 100644
--- /dev/null
+++ b/dts/upstream/src/arm64/allwinner/sun50i-h616-sovol-sv08-diagnostic.dts
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/* Experimental U-Boot-only board DT; not the tested Linux diagnostic DT. */
+#include "sun50i-h616-bigtreetech-cb1.dts"
+
+/ {
+	model = "Sovol SV08 test-sv08-01 U-Boot diagnostic";
+	/* Avoid inherited PH5/PF6/PG15 LED-model output changes. */
+	/delete-node/ leds;
+	aliases {
+		mmc0 = &mmc0;
+		mmc1 = &mmc2;
+	};
+	bootstd {
+		compatible = "u-boot,boot-std";
+		bootdev-order = "mmc1";
+		rauc {
+			compatible = "u-boot,distro-rauc";
+		};
+	};
+};
+
+/* Radio is initialized by Linux, not needed by this eMMC boot path. */
+&mmc1 { status = "disabled"; };
+
+/* Captured vendor and tested Linux DT use no USB VBUS control GPIO. */
+&reg_usb1_vbus { /delete-property/ gpio; };
+&usbotg { dr_mode = "peripheral"; };
+
+&reg_dcdc1 {
+	regulator-min-microvolt = <810000>;
+	regulator-max-microvolt = <990000>;
+};
+&reg_dcdc2 {
+	regulator-min-microvolt = <810000>;
+	regulator-max-microvolt = <1100000>;
+};
+&reg_dcdc3 {
+	regulator-min-microvolt = <1350000>;
+	regulator-max-microvolt = <1500000>;
+};
