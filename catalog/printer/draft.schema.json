{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Printer hardware draft v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "boards",
    "devices",
    "geometry"
  ],
  "properties": {
    "format_version": {
      "enum": [
        1,
        2
      ]
    },
    "boards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "main": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "transport": {
              "enum": [
                "serial",
                "can"
              ]
            },
            "identity": {
              "type": "string",
              "maxLength": 240
            },
            "reference_ack": {
              "type": "boolean"
            }
          }
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "transport": {
              "enum": [
                "serial",
                "can"
              ]
            },
            "identity": {
              "type": "string",
              "maxLength": 240
            },
            "reference_ack": {
              "type": "boolean"
            }
          }
        },
        "chamber": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "transport": {
              "enum": [
                "serial",
                "can"
              ]
            },
            "identity": {
              "type": "string",
              "maxLength": 240
            },
            "reference_ack": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "board",
          "settings"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "kind": {
            "enum": [
              "sensor",
              "input",
              "probe",
              "fan",
              "bed",
              "motor",
              "extruder",
              "chamber",
              "heater_fan",
              "output",
              "neopixel",
              "display",
              "accelerometer",
              "mcu_temperature",
              "pressure_switch"
            ]
          },
          "board": {
            "enum": [
              "main",
              "tool",
              "chamber"
            ]
          },
          "settings": {
            "type": "object",
            "description": "Fields are typed by catalog kinds; runtime rejects unlisted keys."
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_velocity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_accel": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_z_velocity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_z_accel": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "square_corner_velocity": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "definition_plan": {
      "type": "object",
      "required": [
        "format_version",
        "selections",
        "snapshots"
      ],
      "properties": {
        "format_version": {
          "const": 1
        },
        "selections": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object"
          }
        },
        "snapshots": {
          "type": "object"
        },
        "origins": {
          "type": "object"
        },
        "overrides": {
          "type": "object"
        },
        "runtime_assets": {
          "type": "object"
        },
        "instance_values": {
          "type": "object"
        },
        "replacements": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "custom_config": {
      "type": "string",
      "maxLength": 65536
    },
    "native_calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "publication",
        "context",
        "records",
        "bindings"
      ],
      "properties": {
        "format_version": {
          "const": 1
        },
        "publication": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context": {
          "type": "object"
        },
        "records": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 65536
            }
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "message"
          ],
          "properties": {
            "state": {
              "enum": [
                "accepted",
                "pending",
                "conflict"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 256
            }
          }
        },
        "origins": {
          "type": "object",
          "maxProperties": 1024,
          "additionalProperties": {
            "enum": [
              "user-reported",
              "SAVE_CONFIG"
            ]
          }
        }
      }
    },
    "calibration_edits": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "nonce"
        ],
        "properties": {
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "nonce": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "native_calibration"
        ]
      },
      "then": {
        "properties": {
          "format_version": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "calibration_edits"
        ]
      },
      "then": {
        "properties": {
          "format_version": {
            "const": 2
          }
        }
      }
    }
  ]
}
