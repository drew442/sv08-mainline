{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Printer reference catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "boards",
    "curves",
    "kinds"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "role",
          "source",
          "signals",
          "connectors",
          "motors",
          "channel_counts",
          "sharing_rules",
          "reserved_pins"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$"
          },
          "role": {
            "enum": [
              "main",
              "tool",
              "chamber"
            ]
          },
          "sharing_rules": {
            "const": []
          },
          "signals": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "capabilities",
                "source",
                "reserved",
                "evidence"
              ],
              "properties": {
                "capabilities": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "adc",
                      "input",
                      "probe",
                      "fan",
                      "heater",
                      "step",
                      "dir",
                      "enable",
                      "uart",
                      "output"
                    ]
                  }
                },
                "source": {
                  "type": "object",
                  "required": [
                    "line",
                    "section",
                    "option",
                    "reference_only"
                  ],
                  "properties": {
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "reserved": {
                  "type": "boolean"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "presets": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "notes",
                "devices"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,39}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "notes": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "devices": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "kind",
                      "settings",
                      "sources"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,39}$"
                      },
                      "kind": {
                        "enum": [
                          "sensor",
                          "input",
                          "probe",
                          "fan",
                          "bed",
                          "motor",
                          "extruder",
                          "chamber",
                          "heater_fan",
                          "output",
                          "neopixel",
                          "display",
                          "accelerometer",
                          "mcu_temperature",
                          "pressure_switch"
                        ]
                      },
                      "settings": {
                        "type": "object"
                      },
                      "sources": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "object",
                          "required": [
                            "line",
                            "section",
                            "option",
                            "value",
                            "transform"
                          ],
                          "properties": {
                            "line": {
                              "type": "integer",
                              "minimum": 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "supported_transports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "serial",
                "can"
              ]
            }
          }
        }
      }
    },
    "curves": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "sensor_type",
          "reference_pullup",
          "points",
          "limits",
          "origin",
          "source"
        ],
        "properties": {
          "reference_pullup": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "points": {
            "type": [
              "array",
              "null"
            ]
          }
        }
      }
    },
    "kinds": {
      "type": "object",
      "required": [
        "sensor",
        "input",
        "probe",
        "fan",
        "bed",
        "motor",
        "extruder",
        "chamber"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "enum": [
            "adc",
            "address",
            "boolean",
            "byte",
            "color_order",
            "control",
            "curve",
            "endstop_mode",
            "fan",
            "fraction",
            "heater",
            "input",
            "integer",
            "motor",
            "name",
            "nonnegative",
            "nonnegative_integer",
            "number",
            "output",
            "positive",
            "probe",
            "ratio",
            "samples_result",
            "thermistor_points",
            "unit_interval"
          ]
        }
      }
    },
    "factory": {
      "type": "object",
      "required": [
        "printer_settings",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "printer_settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "geometry": {
              "type": "object"
            },
            "bed_mesh": {
              "type": "object"
            },
            "quad_gantry_level": {
              "type": "object"
            },
            "safe_z_home": {
              "type": "object"
            }
          }
        },
        "source": {
          "type": "object"
        }
      }
    }
  }
}
